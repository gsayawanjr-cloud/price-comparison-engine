# Copy to .env and fill in. Never commit .env.

# ─── Trigger.dev ───────────────────────────────────────────────
# cloud.trigger.dev → THIS project (one Trigger.dev project per automation) → API Keys → Development secret key (tr_dev_...)
TRIGGER_SECRET_KEY=

# ─── Anthropic / Claude ───────────────────────────────────────
# Used to judge free-text matches and for the "Open web" research source. Without it, codes and
# part numbers still match, and free-text offers are listed as "weak" for a person to check.
ANTHROPIC_API_KEY=
# Only for org-level keys (error: "not scoped to a workspace"): Settings → Workspaces → workspace ID (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
# Default claude-opus-5-5. claude-sonnet-5-5 costs about 40% as much (the RFQ agent runs on it).
PRICE_MODEL=

# ─── Google Sheet ─────────────────────────────────────────────
# The same service account JSON as the RFQ agent works. The WHOLE JSON on one line.
# Share the sheet with the service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
# docs.google.com/spreadsheets/d/<THIS PART>/edit  (use a separate sheet from the RFQ agent)
PRICE_SHEET_ID=

# ─── Prices ───────────────────────────────────────────────────
# Every offer is converted to this currency for ranking.
BASE_CURRENCY=USD
# Value of 1 unit of each other currency in BASE_CURRENCY. Offers in a currency not listed here
# are shown but ranked last. Update these now and then.
FX_RATES=SGD=0.74,EUR=1.09,PHP=0.017
# Market Check: how far (in %) your price may sit from the market before it is flagged.
PRICE_THRESHOLD_PCT=10
# How long web-research results are reused before searching again.
CACHE_TTL_HOURS=72
# false = skip every supplier marked Mock in the Suppliers tab (set this once real suppliers are in).
INCLUDE_MOCK_SUPPLIERS=true

# --- Cloud switch ---
# true = deploy with the weekly schedule doing nothing; false = deploy live. Required before deploying.
PRICE_PAUSED_PRODUCTION=true
